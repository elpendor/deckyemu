{
  "name": "deckyemu",
  "version": "0.8.4",
  "description": "Add emulated games to your Steam library with proper names and boxart",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "check": "tsc --noEmit && rollup -c && vitest run && python -m mypy py_modules main.py && python scripts/test_backend.py --offline && python scripts/check_release_build.py",
    "deploy": "bash scripts/deploy.sh",
    "dev": "rollup -c && bash scripts/deploy.sh",
    "test": "python scripts/test_backend.py",
    "test:offline": "python scripts/test_backend.py --offline",
    "test:ui": "vitest run",
    "typecheck:py": "python -m mypy py_modules main.py",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elpendor/deckyemu.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "emulation",
    "retroarch",
    "boxart"
  ],
  "author": "Pendor",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/elpendor/deckyemu/issues"
  },
  "homepage": "https://github.com/elpendor/deckyemu#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "^2.0.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
