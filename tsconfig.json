{
  "compilerOptions": {
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "declaration": false,
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    // Two type packages in the dependency tree disagree about Node's `Error`;
    // without this the build fails inside node_modules, not in our code.
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
